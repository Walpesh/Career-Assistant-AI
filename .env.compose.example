# ===== Career-Assistant-AI — production compose overrides (пример) =====
# Скопируйте в .env рядом с docker-compose.yml и заполните секреты.
# CI: docker compose config (валидация без запуска).

# --- Secrets (ОБЯЗАТЕЛЬНО) ---
# JWT_SECRET: минимум 32 символа, НЕ дефолтный (fail-fast в Settings).
JWT_SECRET=change-me-to-a-strong-random-secret-min-32-chars
POSTGRES_USER=career
POSTGRES_PASSWORD=career-strong-password
POSTGRES_DB=career_assistant

# --- Ports ---
API_PORT=8000
FRONTEND_PORT=8080
OLLAMA_PORT=11434

# --- LLM ---
LLM_MODEL=qwen2.5:7b

# --- Email OTP / SMTP (docs/03 §2) ---
# SMTP_HOST ОБЯЗАТЕЛЕН: без него OTP-код некуда отправить и регистрацию
# не завершить. docker-compose требует переменную (${SMTP_HOST:?...}), а
# backend дополнительно падает на старте при ENVIRONMENT=production.
# Порт и режим должны согласованы: 465 ↔ ssl, 587/2525 ↔ starttls.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASSWORD=change-me-smtp-password
SMTP_SECURITY=starttls
EMAILS_FROM=Career-Assistant-AI <mailer@example.com>
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_INTERVAL_SECONDS=60

# --- Scaling ---
# worker-parsing масштабируется: docker compose up --scale worker-parsing=3
PARSING_REPLICAS=2
# worker-llm НЕ масштабировать: строго 1 (1-concurrent-worker limit).

# --- Networking ---
CORS_ORIGINS=http://localhost,http://localhost:8080
TRUSTED_HOSTS=api,localhost,frontend
