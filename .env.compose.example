# ===== Career-Assistant-AI — production compose overrides (пример) =====
# Скопируйте в .env рядом с docker-compose.yml и заполните секреты.
# CI: docker compose config (валидация без запуска).

# --- Secrets (ОБЯЗАТЕЛЬНО) ---
# JWT_SECRET: минимум 32 символа, НЕ дефолтный (fail-fast в Settings).
JWT_SECRET=change-me-to-a-strong-random-secret-min-32-chars
POSTGRES_USER=career
POSTGRES_PASSWORD=career-strong-password
POSTGRES_DB=career_assistant

# --- Ports ---
API_PORT=8000
FRONTEND_PORT=8080
OLLAMA_PORT=11434

# --- LLM ---
LLM_MODEL=qwen2.5:7b

# --- Scaling ---
# worker-parsing масштабируется: docker compose up --scale worker-parsing=3
PARSING_REPLICAS=2
# worker-llm НЕ масштабировать: строго 1 (1-concurrent-worker limit).

# --- Networking ---
CORS_ORIGINS=http://localhost,http://localhost:8080
TRUSTED_HOSTS=api,localhost,frontend
