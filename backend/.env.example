# ===== Career-Assistant-AI — пример окружения =====
# Скопируйте в .env и заполните значения.

# --- Общее ---
DEBUG=false

# --- CORS (откуда открывается frontend) ---
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- PostgreSQL (docs/02_DATABASE.md) ---
DATABASE_URL=postgresql+asyncpg://career:career@localhost:5432/career_assistant

# --- Redis (очередь задач Redis + ARQ и шина событий Realtime Module) ---
REDIS_URL=redis://localhost:6379/0
# Имена очередей: парсинг и LLM обслуживаются раздельно (docs/04 §6)
ARQ_QUEUE_PARSING=career:queue:parsing
ARQ_QUEUE_LLM=career:queue:llm
# Таймаут одной ARQ-задачи, сек (парсинг может идти долго)
ARQ_JOB_TIMEOUT_SECONDS=3600
# Сколько раз ARQ повторит задачу при исключении
ARQ_MAX_TRIES=5
# Глобальный потолок одновременных job'ов очереди парсинга
# (лимит «≤ 2 на пользователя» дополнительно держит Redis-семафор)
ARQ_PARSING_MAX_JOBS=8
# Строго 1: LLM-задачи никогда не выполняются параллельно (docs/05 §1)
ARQ_LLM_MAX_JOBS=1
# Пауза между проверками очереди Redis, сек (в простое БД не опрашивается)
ARQ_POLL_DELAY_SECONDS=0.05
# TTL слота Redis-семафора, сек (защита от залипших слотов после сбоя)
QUEUE_SLOT_TTL_SECONDS=7200
# Возвращать в очередь зависшие задачи при старте (разовая операция)
QUEUE_RECOVER_ON_STARTUP=true
# Поднимать ARQ-воркеры внутри процесса FastAPI.
# false — запускать отдельно:
#   arq app.modules.queue_manager.worker:ParsingQueueSettings
#   arq app.modules.queue_manager.worker:LLMQueueSettings
QUEUE_EMBEDDED_WORKERS=true

# --- JWT ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- LLM (docs/05_LLM_PIPELINE.md) ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT_SECONDS=120
# Лимит compact_resume (TASK: 2000; docs/05 §3 рекомендует 1800–2200)
COMPACT_RESUME_MAX_CHARS=2000

# --- Прокси / антибан (docs/04_PARSING_RULES.md §3.1) ---
# Только резидентные прокси; датацентровые запрещены (проверка в модуле).
# Провайдер: brightdata / smartproxy / decodo / iproyal / soax / proxy-seller и др.
PROXY_PROVIDER=
# Вариант А: шлюз провайдера host:port (sticky-сессии через -session-<id> в user)
PROXY_GATEWAY=
PROXY_USERNAME=
PROXY_PASSWORD=
# Вариант Б: явные URL exit'ов через запятую (приоритет над шлюзом)
PROXY_LIST=
