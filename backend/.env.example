# ===== Career-Assistant-AI — пример окружения =====
# Скопируйте в .env и заполните значения.

# --- Общее ---
DEBUG=false

# --- CORS (откуда открывается frontend) ---
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- PostgreSQL (docs/02_DATABASE.md) ---
DATABASE_URL=postgresql+asyncpg://career:career@localhost:5432/career_assistant

# --- Redis (очереди ARQ + кэш) ---
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- LLM (docs/05_LLM_PIPELINE.md) ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b

# --- Прокси / антибан (docs/04_PARSING_RULES.md) ---
# Только резидентные прокси; задаются в Proxy & Anti-Ban Module.
PROXY_PROVIDER=
PROXY_USERNAME=
PROXY_PASSWORD=
